#!/bin/bash

# omarchy-screensaver-cadence -- a living, rotating ASCII display for Omarchy.
#
# Fork of /usr/share/omarchy/bin/omarchy-screensaver. Window, cursor and input
# handling are unchanged; the difference is where the art comes from. Upstream
# always animates the single file ~/.config/omarchy/branding/screensaver.txt,
# which cannot vary between text art, an image, live data and notifications.
#
# A fork needs its own name rather than shadowing omarchy-screensaver, because
# /usr/share/omarchy/bin is first in PATH and ~/.local/bin is much later.
# omarchy-launch-screensaver therefore still starts the upstream screensaver;
# this is launched directly (SUPER+SHIFT+C).
#
# Slide list syntax, one entry per line, '#' starts a comment:
#   text PATH      ASCII art file, used as-is
#   image PATH     PNG/SVG transcoded with omarchy-transcode-ascii, cached by mtime
#   exec COMMAND   stdout becomes the art, re-run on every rotation
#   notify         newest queued desktop notification, kept for `notify_cycles`
#   set KEY=VALUE  interval, mode, width, height, effects, notify_cycles
#
# An exec slide may also write ttfx arguments to $CADENCE_FLAGS to control the
# animation for that rotation. ttfx picks its effect and gradient when it starts
# and cannot change them mid-run, so a slide that wants a particular colour has
# to be started with that colour. A slide that writes no flags gets --random-effect.
#
# Missing, empty or exhausted slides are skipped, so a pending image or an empty
# notification queue will not break the show.

set -uo pipefail

SLIDES_CONF="${OMARCHY_SCREENSAVER_SLIDES:-$HOME/.config/omarchy/screensaver/slides}"
# YAML config, preferred when present. The line format above stays valid input.
CONFIG_YAML="${OMARCHY_SCREENSAVER_CONFIG:-$HOME/.config/omarchy/screensaver/cadence.yaml}"
STATE_FILE="${OMARCHY_SCREENSAVER_STATE:-$HOME/.config/omarchy/screensaver/state.jsonc}"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy/cadence"
HELPERS="$HOME/.config/omarchy/screensaver"

interval=20
mode=block
width=80
height=26
effects=""
notify_cycles=8
dir_stamp=""

QUEUE="$CACHE_DIR/notifications.jsonl"

primary_specs=()
fallback_specs=()
watch_dirs=()

expand_tilde() { printf '%s' "${1/#\~/$HOME}"; }

# bash cannot parse YAML without extra tooling, so cadence-config.py reads it and
# prints the same line format this script already understands. One parser, and the
# original format keeps working for anyone who prefers it.
resolve_plan() {
  local out="$CACHE_DIR/resolved.plan"
  mkdir -p "$CACHE_DIR"
  python3 "$HELPERS/cadence-config.py" --config "$CONFIG_YAML" --state "$STATE_FILE" \
    >"$out" 2>/dev/null && [[ -s "$out" ]] || return 1
}

config_source() {
  if [[ -r "$CONFIG_YAML" ]] && resolve_plan; then
    printf '%s' "$CACHE_DIR/resolved.plan"
  else
    [[ -r "$SLIDES_CONF" ]] || printf '%s' "$CONFIG_YAML"
    [[ -r "$SLIDES_CONF" ]] || return 1
    printf '%s' "$SLIDES_CONF"
  fi
}

# Slides live in one of two groups. `primary` rotates on its own while any of its
# slides can be produced; otherwise cadence rotates `fallback`. Configs written
# before groups existed have no group lines, so everything lands in fallback and
# behaves exactly as it did.
add_spec() {
  if [[ "$target" == "primary" ]]; then
    primary_specs+=("$1")
  else
    fallback_specs+=("$1")
  fi
}

parse_conf() {
  local line kind value dir dir_mode found source
  primary_specs=()
  fallback_specs=()
  target="fallback"
  watch_dirs=()
  source=$(config_source) || { printf 'omarchy-screensaver-cadence: no usable config\n' >&2; return 1; }
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"
    line="${line#"${line%%[![:space:]]*}"}"
    [[ -z "$line" ]] && continue
    read -r kind value <<<"$line"
    case "$kind" in
      set)
        case "${value%%=*}" in
          interval) interval="${value#*=}" ;;
          mode) mode="${value#*=}" ;;
          width) width="${value#*=}" ;;
          height) height="${value#*=}" ;;
          effects) effects="${value#*=}" ;;
          notify_cycles) notify_cycles="${value#*=}" ;;
        esac
        ;;
      group)
        case "$value" in
          primary) target="primary" ;;
          *) target="fallback" ;;
        esac
        ;;
      text | image | exec | notify) add_spec "$kind $value" ;;
      images)
        # A whole directory of images, expanded to one slide per file in name
        # order. Nothing is written back into that directory: every transcode
        # lands in the cache, keyed by source path, mtime and mode.
        dir="$(expand_tilde "${value%% *}")"
        dir_mode=""
        [[ "$value" == *[[:space:]]* ]] && dir_mode="${value##* }"
        watch_dirs+=("$dir")
        while IFS= read -r found; do
          if [[ -n "$dir_mode" ]]; then
            add_spec "image $found $dir_mode"
          else
            add_spec "image $found"
          fi
        done < <(find "$dir" -maxdepth 1 -type f \
          \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' \
             -o -iname '*.svg' -o -iname '*.webp' \) 2>/dev/null | sort)
        ;;
      *) printf 'omarchy-screensaver-cadence: ignoring unknown entry: %s\n' "$line" >&2 ;;
    esac
  done <"$source"
}

# Render one slide to a file and echo its path. Returns 1 if the slide cannot be
# produced, so the caller can skip it instead of showing a blank screen.
materialise() {
  local spec=$1 cache_id=$2 kind arg out key flags slide_mode
  kind="${spec%% *}"
  arg="$(expand_tilde "${spec#* }")"
  out="$CACHE_DIR/art-$cache_id.txt"
  flags="$CACHE_DIR/art-$cache_id.flags"
  rm -f "$flags"

  case "$kind" in
    text)
      [[ -r "$arg" ]] || return 1
      cp "$arg" "$out" || return 1
      ;;
    image)
      # Optional per-slide mode override: `image PATH braille`. Braille samples
      # 2x4 dots per cell against block's 2x1, so line art and fine detail
      # survive the downsample that block mode flattens into a solid mass.
      slide_mode="$mode"
      if [[ "$arg" =~ ^(.*)[[:space:]]+(braille|block)$ ]]; then
        arg="${BASH_REMATCH[1]}"
        slide_mode="${BASH_REMATCH[2]}"
      fi
      [[ -r "$arg" ]] || return 1
      # Cache by source path so a rebuilt image is picked up, but an unchanged
      # one is not re-transcoded on every rotation.
      key="$CACHE_DIR/$(printf '%s' "$arg" | md5sum | cut -c1-12)-$slide_mode.txt"
      if [[ ! -s "$key" || "$key" -nt "$arg" ]]; then
        omarchy-transcode-ascii "$arg" "$key" \
          -m "$slide_mode" -w "$width" -H "$height" >/dev/null 2>&1 || return 1
      fi
      cp "$key" "$out" || return 1
      ;;
    exec)
      # eval so the slide may quote arguments; the config is the user's own file.
      CADENCE_ART="$out" CADENCE_FLAGS="$flags" eval "$arg" >"$out" 2>/dev/null || true
      ;;
    notify)
      CADENCE_QUEUE="$QUEUE" CADENCE_CYCLES="$notify_cycles" \
        python3 "$HELPERS/notify-slide.py" >"$out" 2>/dev/null || true
      ;;
  esac

  [[ -s "$out" ]] || return 1
  printf '%s' "$out"
}

screensaver_in_focus() {
  hyprctl activewindow -j | jq -e '.class == "org.omarchy.screensaver"' >/dev/null 2>&1
}

exit_cadence() {
  hyprctl eval 'hl.config({ cursor = { invisible = false } })' &>/dev/null || hyprctl keyword cursor:invisible false &>/dev/null || true
  pkill -x ttfx 2>/dev/null
  pkill -f '[o]rg.omarchy.screensaver' 2>/dev/null
  exit 0
}

trap exit_cadence SIGINT SIGTERM SIGHUP SIGQUIT

[[ -r "$SLIDES_CONF" ]] || { printf 'omarchy-screensaver-cadence: no slide list at %s\n' "$SLIDES_CONF" >&2; exit 1; }
mkdir -p "$CACHE_DIR"
parse_conf

# --dump prints every slide's art and exits, so the list can be checked without
# taking over the screen.
if [[ "${1:-}" == "--dump" ]]; then
  for group in primary fallback; do
    [[ "$group" == "primary" ]] && specs=("${primary_specs[@]}") || specs=("${fallback_specs[@]}")
    ((${#specs[@]} == 0)) && continue
    printf -- '=== %s (%d slide(s)) ===\n' "$group" "${#specs[@]}"
    for i in "${!specs[@]}"; do
      if art=$(materialise "${specs[$i]}" "${group:0:1}$i"); then
        printf -- '--- %s: %s ---\n' "$group" "${specs[$i]}"
        cat "$art"
        flags="$CACHE_DIR/art-${group:0:1}$i.flags"
        [[ -s "$flags" ]] && printf -- '    ttfx flags: %s\n' "$(cat "$flags")"
      else
        printf -- '--- %s: %s ---\n    SKIPPED (unreadable, empty or exhausted)\n' "$group" "${specs[$i]}"
      fi
    done
  done
  exit 0
fi

# With no usable slides, behave exactly like upstream rather than showing nothing.
if ((${#primary_specs[@]} == 0 && ${#fallback_specs[@]} == 0)); then
  fallback_specs=("text $HOME/.config/omarchy/branding/screensaver.txt")
fi

printf '\033]11;rgb:00/00/00\007' # Set background color to black

hyprctl eval 'hl.config({ cursor = { invisible = true } })' &>/dev/null || hyprctl keyword cursor:invisible true &>/dev/null

tty=$(tty 2>/dev/null) || tty=""
if [[ -z "$tty" || ! -t 0 ]]; then
  printf 'omarchy-screensaver-cadence: requires an interactive terminal\n' >&2
  exit 1
fi

# Terminals allocate the pty at the default 80x24 and only resize it once the
# compositor has told the window how big it is. ttfx measures the terminal once,
# at startup, so starting it before the resize lands sizes an 80x24 canvas and
# paints it into the corner of a fullscreen window.
wait_for_terminal_resize() {
  local deadline=$((SECONDS + 2))
  while ((SECONDS < deadline)) && [[ $(stty size 2>/dev/null) == "24 80" ]]; do
    sleep 0.02
  done
}

wait_for_terminal_resize

# Dropping a file into a watched directory changes its mtime, so re-parsing the
# slide list is enough to notice. That keeps the folder the single place to add
# images, with no restart and no reloading of the config by hand.
rescan_if_changed() {
  local current="" d
  # Config and toggle state first, so editing cadence.yaml or flipping a bar
  # toggle takes effect without a restart.
  current+="yaml:$(stat -c %Y "$CONFIG_YAML" 2>/dev/null || echo 0)"
  current+="state:$(stat -c %Y "$STATE_FILE" 2>/dev/null || echo 0)"
  for d in "${watch_dirs[@]}"; do
    current+="$d:$(stat -c %Y "$d" 2>/dev/null || echo 0)"
  done
  [[ "$current" == "$dir_stamp" ]] && return 1
  dir_stamp="$current"
  parse_conf
  return 0
}

# Pick the next slide to show. Primary is tried first and on its own: while any
# primary slide can be produced only those rotate, so a queued notification takes
# over the screen. When none can be produced the fallback group takes over, which
# is what stops a primary group like `notify` from leaving the screen empty.
choose_slide() {
  local group specs count i idx cursor art
  for group in primary fallback; do
    if [[ "$group" == "primary" ]]; then
      specs=("${primary_specs[@]}")
      cursor=$p_index
    else
      specs=("${fallback_specs[@]}")
      cursor=$f_index
    fi
    count=${#specs[@]}
    ((count == 0)) && continue
    for ((i = 0; i < count; i++)); do
      idx=$(((cursor + i) % count))
      if art=$(materialise "${specs[$idx]}" "${group:0:1}$idx"); then
        if [[ "$group" == "primary" ]]; then
          p_index=$(((idx + 1) % count))
        else
          f_index=$(((idx + 1) % count))
        fi
        chosen_id="${group:0:1}$idx"
        printf '%s' "$art"
        return 0
      fi
    done
  done
  return 1
}

p_index=0
f_index=0
chosen_id=""
failures=0
next_rescan=$SECONDS
while true; do
  if ((SECONDS >= next_rescan)); then
    next_rescan=$((SECONDS + 20))
    rescan_if_changed
  fi

  art=""
  chosen_id=""
  if art=$(choose_slide); then
    failures=0
    # choose_slide records which slide it picked, so its ttfx flags are known
    # without having to match cache files by content.
    slide_flags="$CACHE_DIR/art-$chosen_id.flags"
    if [[ -n "$slide_flags" && -s "$slide_flags" ]]; then
      flags_arg=$(cat "$slide_flags")
    elif [[ -n "$effects" ]]; then
      flags_arg="$effects"
    else
      flags_arg="--random-effect"
    fi
    clear
    # ttfx is `ttfx [OPTIONS] [COMMAND]`, so the effect subcommand named by
    # $flags_arg must come last, after every global option. Putting it earlier
    # makes ttfx reject the trailing options with "unexpected argument".
    # shellcheck disable=SC2086
    ttfx -i "$art" --frame-rate 120 --canvas-width 0 --canvas-height 0 --reuse-canvas \
      --anchor-canvas c --anchor-text c --no-eol --no-restore-cursor $flags_arg &
    ttfx_pid=$!
  else
    # Skip to the next slide at once rather than holding a blank screen for a
    # whole interval. If every slide is unusable, fall back to waiting one
    # interval so this cannot spin.
    failures=$((failures + 1))
    if ((failures >= ${#primary_specs[@]} + ${#fallback_specs[@]})); then
      sleep "$interval"
      failures=0
    else
      sleep 0.2
    fi
    continue
  fi

  # One second-granularity poll so a keypress or focus loss still exits instantly,
  # exactly as upstream does, while the slide is on screen.
  deadline=$((SECONDS + interval))
  while ((SECONDS < deadline)); do
    if read -n1 -t 1 || ! screensaver_in_focus; then
      exit_cadence
    fi
    ! kill -0 "$ttfx_pid" 2>/dev/null && break
  done

  kill "$ttfx_pid" 2>/dev/null
  wait "$ttfx_pid" 2>/dev/null
done
